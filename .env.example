# Server-only OpenAI credential. Never expose this as NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Optional future real AI overrides. The stable portfolio demo does not require these.
OPENAI_VISION_MODEL=gpt-5.6-terra

# Optional future image generation overrides. Disabled in the default demo flow.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1024x1536
ENABLE_LIVE_IMAGE_GENERATION=false

# Stable portfolio demo mode. Keep true unless you are testing real AI calls.
MUNE_AI_MOCK=true
