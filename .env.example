# Server-only OpenAI credential. Never expose this as NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Optional model override. The default is gpt-5.6-terra.
OPENAI_VISION_MODEL=gpt-5.6-terra

# Optional image generation overrides for the first generated Look image.
# The default image model is gpt-image-2 and the default quality is low.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1024x1536

# Use the same API and weather flow without calling OpenAI.
# Keep false for the real AI MVP.
MUNE_AI_MOCK=false
